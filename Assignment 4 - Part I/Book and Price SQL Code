-- Create the Book table
CREATE TABLE Book (
    id INT NOT NULL AUTO_INCREMENT,
    name VARCHAR(100) NOT NULL,
    PRIMARY KEY (id)
);

-- Add book records
INSERT INTO Book
(id, name)
VALUES
(1,'MariaDB Book1'),
(2,'MariaDB Book2'),
(3,'MariaDB Book3'),
(4,'MariaDB Book4'),
(5,'MariaDB Book5');

SELECT * FROM Book;

-- Update the first book name
UPDATE Book
SET name = 'MariaDB Book1a'
WHERE id = 1;


-- Create the Price table
CREATE TABLE Price (
    id INT NOT NULL AUTO_INCREMENT,
    price FLOAT NOT NULL,
    PRIMARY KEY (id)
);

-- Add prices associated with each book ID
INSERT INTO Price
(id, price)
VALUES
(1, 251),
(2, 252),
(3, 223),
(4, 194),
(5, 305);

SELECT * FROM Price;

-- Update the first price
UPDATE Price
SET price = 250
WHERE id = 1;


-- Join Book and Price using their matching IDs
SELECT Book.name, Price.price
FROM Book
INNER JOIN Price
ON Book.id = Price.id;
